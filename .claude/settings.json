{
  "permissions": {
    "allow": [
      "Bash(lifecycle doctor:*)",
      "Bash(lifecycle config:*)",
      "Bash(lifecycle where:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "lifecycle-kit": {
      "source": {
        "source": "github",
        "repo": "orwir/lifecycle-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "lifecycle@lifecycle-kit": true
  }
}
